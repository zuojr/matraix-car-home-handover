{
  "sut": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5.6-sol",
    "timeout": 180,
    "max_tokens": 16384,
    "options": {"reasoning_effort": "medium"}
  },
  "put": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "timeout": 120,
    "max_tokens": 512,
    "options": {"thinking": {"type": "disabled"}, "response_format": {"type": "json_object"}}
  },
  "limits": {"max_sut_calls_per_case": 160, "max_persona_turns": 64, "max_total_api_requests": 4000, "chat_timeout": 1200},
  "concurrency": 2
}
