{
  "sut": {
    "base_url": "https://api.openai.com/v1", "model": "gpt-5.6-sol",
    "timeout": 180, "max_tokens": 16384,
    "options": {"reasoning_effort": "medium"}
  },
  "put": {
    "base_url": "https://api.openai.com/v1", "model": "gpt-5.6-sol",
    "timeout": 180, "max_tokens": 512,
    "options": {
      "reasoning_effort": "none",
      "response_format": {
        "type": "json_schema", "name": "persona_act", "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "act": {"type": "string", "enum": ["continue", "clarify", "stop"]},
            "style": {"type": "string", "enum": ["terse", "balanced", "polite"]}
          },
          "required": ["act", "style"], "additionalProperties": false
        }
      }
    }
  },
  "limits": {"max_sut_calls_per_case": 160, "max_persona_turns": 64, "max_total_api_requests": 2000, "chat_timeout": 1200},
  "concurrency": 4
}
