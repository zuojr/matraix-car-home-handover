# Copy as a local, untracked .env. Never commit keys.
JOURNEY_CONTROL_TOKEN=replace-with-a-unique-local-random-token
JOURNEY_MODE=reference
# Model mode additionally requires a verified portable plan under ./plan.
JOURNEY_SUT_BASE_URL=
JOURNEY_SUT_MODEL=
JOURNEY_SUT_API_KEY=
# PUT configuration belongs on the controller host, never the simulator service.
JOURNEY_PUT_BASE_URL=
JOURNEY_PUT_MODEL=
JOURNEY_PUT_API_KEY=
